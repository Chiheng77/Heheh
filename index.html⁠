    let currentMode = 'practice';
    let questions = [];
    let currentIndex = 0;
    let userAnswers = {};
    let timerInterval = null;
    let timeLeft = 25 * 60;

    // Fisher-Yates Shuffle
    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function setMode(mode) {
      currentMode = mode;
      document.getElementById('card-practice').classList.toggle('active', mode === 'practice');
      document.getElementById('card-exam').classList.toggle('active', mode === 'exam');
      document.getElementById('mode-practice').checked = (mode === 'practice');
      document.getElementById('mode-exam').checked = (mode === 'exam');
    }

    function prepareData() {
      const cloned = JSON.parse(JSON.stringify(rawQuestions));
      cloned.forEach(q => {
        const correctVal = q.options[0];
        shuffle(q.options);
        q.correct = q.options.indexOf(correctVal);
      });
      questions = shuffle(cloned);
      currentIndex = 0;
      userAnswers = {};
      timeLeft = 25 * 60;
    }

    function startQuiz() {
      if (timerInterval) clearInterval(timerInterval);
      prepareData();

      document.getElementById('screen-start').classList.add('hide');
      document.getElementById('screen-result').classList.add('hide');
      document.getElementById('screen-quiz').classList.remove('hide');

      const modeBadge = document.getElementById('badge-current-mode');
      const timerDisplay = document.getElementById('timer-display');

      if (currentMode === 'practice') {
        modeBadge.textContent = 'របៀបអនុវត្ត';
        timerDisplay.style.display = 'none';
      } else {
        modeBadge.textContent = 'របៀបប្រឡង';
        timerDisplay.style.display = 'inline-flex';
        startTimer();
      }

      renderPalette();
      loadQuestion(0);
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      updateTimerUI();
      timerInterval = setInterval(() => {
        timeLeft--;
        updateTimerUI();
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          alert("អស់ពេលធ្វើតេស្តហើយ! កម្មវិធីនឹងផ្ញើចម្លើយដោយស្វ័យប្រវត្តិ។");
          finishQuiz();
        }
      }, 1000);
    }

    function updateTimerUI() {
      const min = Math.floor(timeLeft / 60);
      const sec = timeLeft % 60;
      document.getElementById('timer-display').textContent = 
        `⏱️ ${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
    }

    function loadQuestion(index) {
      currentIndex = index;
      const q = questions[currentIndex];

      document.getElementById('q-counter').textContent = `សំណួរទី ${currentIndex + 1} / ${questions.length}`;
      document.getElementById('progress-bar').style.width = `${((currentIndex + 1) / questions.length) * 100}%`;
      document.getElementById('question-text').textContent = q.question;

      const container = document.getElementById('options-container');
      container.innerHTML = '';
      const feedbackBox = document.getElementById('practice-feedback');
      feedbackBox.className = 'explanation-box hide';
      feedbackBox.innerHTML = '';

      const letters = ['A', 'B', 'C', 'D'];
      const answered = userAnswers[currentIndex] !== undefined;

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('div');
        btn.className = 'option-btn';

        if (currentMode === 'practice') {
          if (answered) {
            btn.classList.add('disabled');
            if (idx === q.correct) btn.classList.add('correct');
            if (userAnswers[currentIndex] === idx && idx !== q.correct) btn.classList.add('wrong');
          } else {
            btn.onclick = () => selectOption(idx);
          }
        } else {
          // Exam Mode
          if (userAnswers[currentIndex] === idx) btn.classList.add('selected');
          btn.onclick = () => selectOption(idx);
        }

        btn.innerHTML = `
          <div class="opt-letter">${letters[idx]}</div>
          <div class="opt-text">${opt}</div>
        `;
        container.appendChild(btn);
      });

      // Show Instant Feedback in Practice Mode
      if (currentMode === 'practice' && answered) {
        const isRight = (userAnswers[currentIndex] === q.correct);
        feedbackBox.classList.remove('hide');
        if (isRight) {
          feedbackBox.className = 'explanation-box correct';
          feedbackBox.innerHTML = `<strong>🎉 ចម្លើយត្រឹមត្រូវ!</strong> អ្នកបានជ្រើសរើសចម្លើយត្រឹមត្រូវគឺ៖ ${letters[q.correct]}. ${q.options[q.correct]}`;
        } else {
          feedbackBox.className = 'explanation-box wrong';
          feedbackBox.innerHTML = `<strong>❌ ចម្លើយមិនទាន់ត្រឹមត្រូវទេ!</strong><br>ចម្លើយដែលត្រឹមត្រូវគឺ៖ <strong>${letters[q.correct]}. ${q.options[q.correct]}</strong>`;
        }
      }

      document.getElementById('btn-prev').style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
      const nextBtn = document.getElementById('btn-next');
      nextBtn.textContent = (currentIndex === questions.length - 1) ? 'បញ្ចប់ការធ្វើតេស្ត' : 'បន្ទាប់';

      updatePalette();
      triggerMathRender();
    }

    function selectOption(idx) {
      userAnswers[currentIndex] = idx;
      loadQuestion(currentIndex);
    }

    function nextQuestion() {
      if (currentIndex === questions.length - 1) {
        finishQuiz();
      } else {
        loadQuestion(currentIndex + 1);
      }
    }

    function prevQuestion() {
      if (currentIndex > 0) {
        loadQuestion(currentIndex - 1);
      }
    }

    function renderPalette() {
      const container = document.getElementById('palette-container');
      container.innerHTML = '';
      questions.forEach((_, i) => {
        const btn = document.createElement('button');
        btn.className = 'palette-btn';
        btn.id = `palette-${i}`;
        btn.textContent = i + 1;
        btn.onclick = () => loadQuestion(i);
        container.appendChild(btn);
      });
    }

    function updatePalette() {
      questions.forEach((_, i) => {
        const btn = document.getElementById(`palette-${i}`);
        if (!btn) return;
        btn.className = 'palette-btn';
        if (i === currentIndex) btn.classList.add('active');
        if (userAnswers[i] !== undefined) btn.classList.add('answered');
      });
    }

    function finishQuiz() {
      if (timerInterval) clearInterval(timerInterval);

      document.getElementById('screen-quiz').classList.add('hide');
      document.getElementById('screen-result').classList.remove('hide');

      let score = 0;
      const reviewContainer = document.getElementById('review-list');
      reviewContainer.innerHTML = '';
      const letters = ['A', 'B', 'C', 'D'];

      questions.forEach((q, i) => {
        const selected = userAnswers[i];
        const isCorrect = (selected === q.correct);
        if (isCorrect) score++;

        const card = document.createElement('div');
        card.className = `review-card ${isCorrect ? 'correct' : 'wrong'}`;
        card.innerHTML = `
          <p style="font-weight: 600; margin-bottom: 6px;">${i + 1}. ${q.question}</p>
          <p style="font-size: 0.9rem;">
            ចម្លើយរបស់អ្នក៖ <strong style="color: ${isCorrect ? 'var(--success)' : 'var(--danger)'}">
              ${selected !== undefined ? `${letters[selected]}.${q.options[selected]}` : 'មិនបានឆ្លើយ'}
            </strong>
          </p>
          ${!isCorrect ? `<p style="font-size: 0.9rem; color: #059669; margin-top: 4px;">ចម្លើយត្រឹមត្រូវ៖ <strong>${letters[q.correct]}.${q.options[q.correct]}</strong></p>` : ''}
        `;
        reviewContainer.appendChild(card);
      });

      const percent = Math.round((score / questions.length) * 100);
      document.getElementById('final-score').textContent = score;
      document.getElementById('result-detail').textContent = `ទទួលបាន ${percent}% នៃពិន្ទុសរុប`;

      const msg = document.getElementById('result-message');
      if (percent >= 80) msg.textContent = "🎉 ល្អឥតខ្ចោះ! អ្នកយល់ច្បាស់មេរៀននេះ!";
      else if (percent >= 50) msg.textContent = "👍 ល្អបង្គួរ! ព្យាយាមម្តងទៀតដើម្បីបានពិន្ទុពេញ!";
      else msg.textContent = "💪 ព្យាយាមម្តងទៀត! ពិនិត្យកំហុសខាងក្រោមដើម្បីរៀនបន្ថែម!";

      triggerMathRender();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function shareSite() {
      if (navigator.share) {
        navigator.share({
          title: 'វិញ្ញាសាគីមីវិទ្យា MCQ 25',
          text: 'ចូលរួមធ្វើតេស្តវិញ្ញាសាគីមីវិទ្យាជាមួយខ្ញុំទាំងអស់គ្នា!',
          url: window.location.href
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert("បានចម្លង Link ចូលទៅក្នុង Clipboard រួចរាល់! អ្នកអាចផ្ញើវាទៅកាន់មិត្តភក្តិបាន។");
      }
    }

    // Reliable KaTeX renderer with auto-retry for slower mobile connections
    function triggerMathRender() {
      const render = () => {
        if (window.renderMathInElement) {
          renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false }
            ],
            throwOnError: false
          });
        } else {
          setTimeout(render, 100);
        }
      };
      render();
    }

    window.addEventListener('DOMContentLoaded', triggerMathRender);
  </script>
</body>
</html>
